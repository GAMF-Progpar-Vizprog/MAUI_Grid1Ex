<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_GridEx.MainPage">

	<Grid RowDefinitions="70,1.5*,0.5*,Auto" ColumnDefinitions="2*,1*" Padding="5" ColumnSpacing="10"
				RowSpacing="10">
		<Label Text="ColumnSpan" Grid.ColumnSpan="2"  BackgroundColor="Beige" Grid.Row="0" 
					 HorizontalOptions="Fill"
					 HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
		<Border Grid.Row="1" Grid.Column="0" BackgroundColor="AliceBlue" StrokeShape="RoundRectangle 8"/>
		<Border Grid.Row="1" Grid.Column="1" BackgroundColor="Aqua" StrokeShape="RoundRectangle 8"/>
		<Border Grid.Row="2" Grid.Column="0" BackgroundColor="Violet" StrokeShape="RoundRectangle 8"/>
		<Border Grid.Row="2" Grid.Column="1" BackgroundColor="Honeydew" StrokeShape="RoundRectangle 8"/>
		<Button Text="Left" Grid.Row="3" Grid.Column="0" HeightRequest="40"/>
		<Button Text="Right" Grid.Row="3" Grid.Column="1" HeightRequest="40" Margin="10,0,10,0"/>
	</Grid>
</ContentPage>
